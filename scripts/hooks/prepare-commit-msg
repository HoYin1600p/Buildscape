#!/usr/bin/env bash
set -euo pipefail

# Guard against recursive hook invocation when committing inside submodules
if [ "${BUILDSCAPE_SUBMODULE_COMMIT:-0}" = "1" ]; then
    exit 0
fi

COMMIT_MSG_FILE="${1:-}"
COMMIT_SOURCE="${2:-}"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

# Skip merge/squash/commit-id sources unless normal commit
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ ! -f "$ROOT_DIR/.gitmodules" ]; then
    exit 0
fi

# Extract non-comment commit message to check if empty
MSG_CONTENT="$(grep -v '^#' "$COMMIT_MSG_FILE" | sed '/^[[:space:]]*$/d' || true)"
if [ -z "$MSG_CONTENT" ]; then
    exit 0
fi

# Preserve parent author identity if provided
AUTHOR_NAME="${GIT_AUTHOR_NAME:-$(git config user.name || echo 'kyroxova')}"
AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$(git config user.email || echo '314620997+KyroXova@users.noreply.github.com')}"

export BUILDSCAPE_SUBMODULE_COMMIT=1

commit_submodule() {
    local sub_path="$1"
    local full_path="$ROOT_DIR/$sub_path"
    if [ ! -e "$full_path/.git" ]; then
        return 0
    fi
    if [ -n "$(git -C "$full_path" status --porcelain 2>/dev/null)" ]; then
        git -C "$full_path" add -A
        if ! git -C "$full_path" diff --cached --quiet 2>/dev/null; then
            GIT_AUTHOR_NAME="$AUTHOR_NAME" GIT_AUTHOR_EMAIL="$AUTHOR_EMAIL" \
            GIT_COMMITTER_NAME="$AUTHOR_NAME" GIT_COMMITTER_EMAIL="$AUTHOR_EMAIL" \
            git -C "$full_path" commit -F "$COMMIT_MSG_FILE" --no-verify >/dev/null
            git -C "$ROOT_DIR" add "$sub_path"
        fi
    fi
}

commit_submodule "shared"
for ver_dir in "$ROOT_DIR"/versions/*; do
    if [ -d "$ver_dir" ]; then
        commit_submodule "versions/$(basename "$ver_dir")"
    fi
done
