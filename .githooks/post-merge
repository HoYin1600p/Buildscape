#!/usr/bin/env sh
# Auto-sync and update submodules after git pull / git merge in the root repository.
[ -f .gitmodules ] || exit 0
[ "${BUILDSCAPE_SKIP_SUBMODULE_AUTOUPDATE:-0}" = "1" ] && exit 0

unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
git submodule sync --recursive >/dev/null 2>&1 || true
git submodule update --init --recursive
